from datetime import datetime
import numpy as np

class ATMCore:
    def __init__(self):
        print("🔍 Sistema ATM Inicializado em Três Passos/RS")
        self.energia_ativa = False

    def check_sistemas(self):
        print("\n[!] Checando integridade dos 10 repositórios...")
        print("[OK] FusionCore: Conectado")
        print("[OK] Nave-Espacial: Motores Inerciais prontos")
        print("[OK] Assinaturas-de-risco: Banco de dados carregado")
        self.energia_ativa = True

    def iniciar_missao(self, ambiente="solo"):
        if self.energia_ativa:
            resultado = f"Missão em ambiente {ambiente}: Solo seguro para perfuração."
            print(resultado)
            self.salvar_log("Missão", resultado)
        else:
            erro = "❌ Erro: Falha no FusionCore."
            print(erro)
            self.salvar_log("Erro", erro)

    def salvar_log(self, operacao, resultado):
        with open("log_atm.txt", "a", encoding="utf-8") as f:
            f.write(f"{datetime.now()} | {operacao} | {resultado}\n")

    def exportar_logs(self, filtro, arquivo_destino):
        """Exporta logs filtrados e adiciona resumo estatístico"""
        total = 0
        try:
            with open("log_atm.txt", "r", encoding="utf-8") as f_in, open(arquivo_destino, "w", encoding="utf-8") as f_out:
                for linha in f_in:
                    if filtro.lower() in linha.lower():
                        f_out.write(linha)
                        total += 1
                # Adiciona resumo ao final
                f_out.write("\n--- RESUMO ESTATÍSTICO ---\n")
                f_out.write(f"Total de registros exportados ({filtro}): {total}\n")
            print(f"[EXPORT] Relatório gerado em {arquivo_destino} com {total} entradas.")
        except FileNotFoundError:
            print("Nenhum log encontrado para exportação.")

# --- Execução ---
atm = ATMCore()
atm.check_sistemas()
atm.iniciar_missao("gases")
atm.iniciar_missao("solo")
atm.iniciar_missao("agua")

# Exportar apenas logs de Missão com resumo
atm.exportar_logs("Missão", "relatorio_missoes.txt")

# Exportar apenas logs de Erro com resumo
atm.exportar_logs("Erro", "relatorio_erros.txt")
